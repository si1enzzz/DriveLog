{
  "name": "DriveLog (.NET 10 & Avalonia)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "AvaloniaTeam.vscode-avalonia"
      ],
      "settings": {
        "dotnet.defaultSolution": "DriveLog/DriveLog.slnx",
        "omnisharp.enableRoslynAnalyzers": true,
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "dotnet --version && dotnet restore DriveLog/DriveLog.slnx"
}
