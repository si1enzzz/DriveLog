<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.timur.drivelog</ApplicationId>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>0.39</ApplicationDisplayVersion>
    <ApplicationTitle>DriveLog</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <TrimMode>partial</TrimMode>
    <PublishTrimmed>true</PublishTrimmed>
    <AndroidSdkDirectory>D:\androidSDK</AndroidSdkDirectory>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RootNamespace>DriveLog.Android</RootNamespace>
    <AssemblyName>DriveLog.Android</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="DriveLog" RootMode="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveLog\DriveLog.csproj" />
  </ItemGroup>
</Project>