<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveLog.ViewModels"
             xmlns:m="using:DriveLog.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="470" d:DesignHeight="880"
             x:Class="DriveLog.Views.MainView" x:Name="RootView"
             x:DataType="vm:MainViewModel"
             Background="{Binding BgColor}">

    <!-- Глобальные стили контролов -->
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="MaxDropDownHeight" Value="150" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ShowButtonSpinner" Value="False" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>



        <Style Selector="DatePicker">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="DatePicker /template/ Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="DatePicker /template/ TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Автоскрытие полосы прокрутки через 2 секунды с плавным затуханием -->
        <Style Selector="ScrollViewer /template/ ScrollBar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*, Auto">
        <!-- СЛОЙ 0: Содержимое вкладок (Row 0) -->

        <!-- ==================== ВКЛАДКА 1: ГАРАЖ ==================== -->
        <ScrollViewer Grid.Row="0" Margin="16" IsVisible="{Binding IsGarageTab}">
            <StackPanel Spacing="14" Margin="0, 0, 0, 80">

                <!-- ВЕРХНЯЯ СТРОКА: 3 отдельных раздельных элемента -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- 1. Кружок «+» Добавить авто -->
                    <Button Grid.Column="0" 
                            Command="{Binding ToggleAddVehicleCommand}"
                            ToolTip.Tip="{Binding Strings.AddFirstVehicle}"
                            Background="#074CBA"
                            Foreground="White"
                            FontWeight="Bold"
                            Width="44" Height="44"
                            Padding="0"
                            CornerRadius="22"
                            Margin="0, 0, 10, 0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#0A5CE0" />
                                <Setter Property="CornerRadius" Value="22" />
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="#05378A" />
                                <Setter Property="CornerRadius" Value="22" />
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="+" FontSize="24" FontWeight="Black" Margin="0, -2, 0, 0" />
                    </Button>

                    <!-- 2. Закруглённая плашка для выбора машины -->
                    <Border Grid.Column="1"
                            Background="{Binding CardColor}"
                            BorderBrush="{Binding CardBorderColor}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Height="44"
                            Margin="0, 0, 10, 0"
                            Padding="8, 0">
                        <ComboBox ItemsSource="{Binding Vehicles}" 
                                  SelectedItem="{Binding SelectedVehicle}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CornerRadius="20"
                                  PlaceholderText="{Binding Strings.GarageEmptyPlaceholder}">
                            <ComboBox.Styles>
                                <Style Selector="ComboBox:pointerover">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="20" />
                                </Style>
                                <Style Selector="ComboBox:pressed">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="CornerRadius" Value="20" />
                                </Style>
                                <Style Selector="ComboBoxItem">
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Margin" Value="4, 2" />
                                    <Setter Property="Padding" Value="12, 8" />
                                </Style>
                                <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="CornerRadius" Value="10" />
                                </Style>
                                <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="CornerRadius" Value="10" />
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Vehicle">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <!-- 3. Кружок «Удалить» авто -->
                    <Button Grid.Column="2" 
                            Command="{Binding RequestDeleteVehicleCommand}"
                            IsEnabled="{Binding CanDeleteVehicle}"
                            ToolTip.Tip="{Binding Strings.DeleteCar}"
                            Background="{Binding CardColor}"
                            BorderBrush="{Binding CardBorderColor}"
                            BorderThickness="1"
                            Width="44" Height="44"
                            Padding="0"
                            CornerRadius="22"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{Binding CardBorderColor}" />
                                <Setter Property="CornerRadius" Value="22" />
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{Binding CardBorderColor}" />
                                <Setter Property="CornerRadius" Value="22" />
                            </Style>
                        </Button.Styles>
                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Width="18" Height="18"
                                  Foreground="#E03E3E" />
                    </Button>
                </Grid>

                <!-- КОНТЕНТ ВЫБРАННОГО АВТО (когда в гараже есть машины) -->
                <StackPanel Spacing="14" IsVisible="{Binding HasVehicles}">
                    <!-- Карточка выбранного авто -->
                    <Border Background="{Binding CardColor}" 
                            CornerRadius="16" 
                            Padding="18"
                            BorderBrush="{Binding CardBorderColor}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- Название авто и кнопка редактирования (карандашик) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding SelectedVehicle.Title}" FontSize="24" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding EditCurrentVehicleCommand}"
                                        ToolTip.Tip="{Binding Strings.EditVehicle}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{Binding CardBorderColor}" />
                                            <Setter Property="CornerRadius" Value="18" />
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{Binding CardBorderColor}" />
                                            <Setter Property="CornerRadius" Value="18" />
                                        </Style>
                                    </Button.Styles>
                                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                              Width="18" Height="18"
                                              Foreground="{Binding TextSecondaryColor}" />
                                </Button>
                            </Grid>
                            
                            <!-- Характеристики (поколение, двигатель, год, цвет) -->
                            <TextBlock Text="{Binding SelectedVehicle.SubDetails}" Foreground="{Binding TextSecondaryColor}" FontSize="13" TextWrapping="Wrap" />

                            <!-- Пробег (синий) и расходы (белый в темной теме / черный в светлой) -->
                            <Grid ColumnDefinitions="*, Auto" Margin="0, 6, 0, 0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings.CurrentMileage}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                    <TextBlock FontSize="22" FontWeight="Black" Foreground="#074CBA">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0} {1}">
                                                <Binding Path="SelectedVehicle.CurrentMileage" />
                                                <Binding Path="Strings.KmSuffix" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Strings.TotalSpent}" Foreground="{Binding TextSecondaryColor}" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding SelectedVehicle.TotalSpent, StringFormat='{}{0:N0} ₽'}" 
                                               FontSize="22" FontWeight="Black" Foreground="{Binding TextHighlightColor}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Заголовок истории обслуживания -->
                    <TextBlock Text="{Binding Strings.ServiceHistory}" FontSize="17" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="4, 4, 0, 0" />

                    <!-- Список записей выбранной машины -->
                    <ItemsControl ItemsSource="{Binding SelectedVehicle.Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:ServiceRecord">
                                <!-- Карточка одной замены -->
                                <Border Background="{Binding #RootView.((vm:MainViewModel)DataContext).CardColor}" 
                                        CornerRadius="14" 
                                        Margin="0, 0, 0, 10" 
                                        Padding="16"
                                        BorderBrush="{Binding #RootView.((vm:MainViewModel)DataContext).CardBorderColor}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <!-- Название детали, общая стоимость и кнопки действий -->
                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                            <TextBlock Text="{Binding PartTitle}" FontSize="15" FontWeight="SemiBold" 
                                                       Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextPrimaryColor}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalCost, StringFormat='{}{0:N0} ₽'}" 
                                                       FontSize="16" FontWeight="Bold" Foreground="#074CBA" Margin="8,0,8,0" VerticalAlignment="Center" />
                                            
                                            <!-- Кнопки: Редактировать (карандашик) и Удалить (корзинка) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Command="{Binding #RootView.((vm:MainViewModel)DataContext).EditRecordCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding #RootView.((vm:MainViewModel)DataContext).Strings.EditRecord}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Width="30" Height="30"
                                                        CornerRadius="15">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="{Binding #RootView.((vm:MainViewModel)DataContext).CardBorderColor}" />
                                                            <Setter Property="CornerRadius" Value="15" />
                                                        </Style>
                                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="{Binding #RootView.((vm:MainViewModel)DataContext).CardBorderColor}" />
                                                            <Setter Property="CornerRadius" Value="15" />
                                                        </Style>
                                                    </Button.Styles>
                                                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                              Width="14" Height="14"
                                                              Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" />
                                                </Button>

                                                <Button Command="{Binding #RootView.((vm:MainViewModel)DataContext).RequestDeleteRecordCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Width="30" Height="30"
                                                        CornerRadius="15">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="#33E03E3E" />
                                                            <Setter Property="CornerRadius" Value="15" />
                                                        </Style>
                                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="#66E03E3E" />
                                                            <Setter Property="CornerRadius" Value="15" />
                                                        </Style>
                                                    </Button.Styles>
                                                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                              Width="14" Height="14"
                                                              Foreground="#E03E3E" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Информация: Пробег, Умная дата, Сервис -->
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" FontSize="13">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} {1}">
                                                        <Binding Path="Mileage" />
                                                        <Binding Path="#RootView.((vm:MainViewModel)DataContext).Strings.KmSuffix" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="  ·  " Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" FontSize="13" />
                                            <TextBlock Text="{Binding DisplayDate}" Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" FontSize="13" />
                                            <TextBlock Text="  ·  " Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" FontSize="13" />
                                            <TextBlock Text="{Binding ServiceName}" Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" FontSize="13" />
                                        </WrapPanel>

                                        <!-- Цены: деталь + работа -->
                                        <TextBlock Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}: {1:N0} {4}   {2}: {3:N0} {4}">
                                                    <Binding Path="#RootView.((vm:MainViewModel)DataContext).Strings.PartCost" />
                                                    <Binding Path="PartCost" />
                                                    <Binding Path="#RootView.((vm:MainViewModel)DataContext).Strings.LaborCost" />
                                                    <Binding Path="LaborCost" />
                                                    <Binding Path="#RootView.((vm:MainViewModel)DataContext).Strings.CurrencySuffix" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- Заметка (если есть) -->
                                        <TextBlock Text="{Binding Notes}" 
                                                   Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).TextSecondaryColor}" 
                                                   FontSize="12" FontStyle="Italic" TextWrapping="Wrap" 
                                                   IsVisible="{Binding HasNotes}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ПУСТОЙ ГАРАЖ (когда машин еще нет) -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="28, 36" 
                        BorderBrush="{Binding CardBorderColor}" 
                        BorderThickness="1" 
                        IsVisible="{Binding !HasVehicles}" 
                        Margin="0, 20, 0, 0">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Strings.EmptyGarageTitle}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{Binding TextPrimaryColor}" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Strings.EmptyGarageDesc}" 
                                   Foreground="{Binding TextSecondaryColor}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   MaxWidth="320" />
                        <Button Content="{Binding Strings.AddFirstVehicle}" 
                                Command="{Binding ToggleAddVehicleCommand}" 
                                Background="#074CBA" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="14" 
                                Height="42" 
                                Padding="24, 0" 
                                CornerRadius="8" 
                                HorizontalAlignment="Center" 
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" 
                                Margin="0, 8, 0, 0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ПЛАВАЮЩАЯ КНОПКА (FAB) ДЛЯ ДОБАВЛЕНИЯ ЗАПИСИ О ЗАМЕНЕ -->
        <Border Grid.Row="0"
                IsVisible="{Binding CanShowFab}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0, 0, 20, 24"
                Width="54" Height="54"
                CornerRadius="27"
                ClipToBounds="True"
                BoxShadow="0 6 20 #80074CBA">
            <Button Command="{Binding ToggleAddFormCommand}"
                    Width="54" Height="54"
                    CornerRadius="27"
                    Background="#074CBA"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="{Binding Strings.NewRecord}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#0A5CE0" />
                        <Setter Property="CornerRadius" Value="27" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#05378A" />
                        <Setter Property="CornerRadius" Value="27" />
                    </Style>
                </Button.Styles>
                <TextBlock Text="+" FontSize="28" FontWeight="Black" Margin="0, -2, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Border>

        <!-- ==================== ВКЛАДКА 2: АККАУНТ И НАСТРОЙКИ ==================== -->
        <ScrollViewer Grid.Row="0" Margin="16" IsVisible="{Binding IsAccountTab}">
            <StackPanel Spacing="14" Margin="0, 0, 0, 80">

                <!-- ШАПКА ПРОФИЛЯ ВОДИТЕЛЯ -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="18"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto, *">
                        <!-- Аватарка водителя -->
                        <Border Grid.Column="0" 
                                Width="56" Height="56" 
                                CornerRadius="28" 
                                Background="{Binding CardBorderColor}" 
                                BorderBrush="#074CBA" 
                                BorderThickness="2"
                                Margin="0, 0, 14, 0">
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Width="26" Height="26"
                                      Foreground="#074CBA"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Имя и бейдж -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding DriverName}" 
                                           FontSize="20" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" />
                                <Border Grid.Column="1" Background="{Binding CardBorderColor}" CornerRadius="6" Padding="8, 2">
                                    <TextBlock Text="{Binding Strings.Guest}" Foreground="{Binding TextSecondaryColor}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Strings.DrivingExp}" 
                                       Foreground="{Binding TextSecondaryColor}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА СВОДНОЙ СТАТИСТИКИ -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="18"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Strings.SummaryStats}" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" />

                        <Grid ColumnDefinitions="*, *, *">
                            <!-- Всего авто -->
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Strings.VehiclesCount}" Foreground="{Binding TextSecondaryColor}" FontSize="11" />
                                <TextBlock Text="{Binding Vehicles.Count}" FontSize="20" FontWeight="Black" Foreground="{Binding TextPrimaryColor}" />
                            </StackPanel>

                            <!-- Всего замен -->
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Strings.TotalRecords}" Foreground="{Binding TextSecondaryColor}" FontSize="11" />
                                <TextBlock Text="{Binding TotalRecordsCount}" FontSize="20" FontWeight="Black" Foreground="{Binding TextPrimaryColor}" />
                            </StackPanel>

                            <!-- Общие затраты -->
                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Strings.TotalExpenses}" Foreground="{Binding TextSecondaryColor}" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding TotalGarageSpent, StringFormat='{}{0:N0} ₽'}" 
                                           FontSize="17" FontWeight="Black" Foreground="#074CBA" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ЭКСПОРТ ДАННЫХ И ОТЧЁТОВ -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="18"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Strings.ExportTitle}" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" />
                        <TextBlock Text="{Binding Strings.ExportDesc}" 
                                   Foreground="{Binding TextSecondaryColor}" FontSize="12" TextWrapping="Wrap" LineHeight="16" />

                        <!-- Статус сохранения -->
                        <TextBlock Text="{Binding ExportStatusMessage}" 
                                   Foreground="#074CBA" FontSize="12" FontWeight="SemiBold" 
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*, *, *" Margin="0, 4, 0, 0">
                            <!-- Экспорт в Markdown -->
                            <Button Grid.Column="0" 
                                    Content="Markdown"
                                    Command="{Binding ExportSelectedVehicleCommand}"
                                    CommandParameter="md"
                                    Background="#074CBA" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" Height="36" CornerRadius="8"
                                    HorizontalAlignment="Stretch" Margin="0, 0, 4, 0" />

                            <!-- Экспорт в TXT -->
                            <Button Grid.Column="1" 
                                    Content="{Binding Strings.ExportTxt}"
                                    Command="{Binding ExportSelectedVehicleCommand}"
                                    CommandParameter="txt"
                                    Background="#074CBA" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" Height="36" CornerRadius="8"
                                    HorizontalAlignment="Stretch" Margin="4, 0, 4, 0" />

                            <!-- Экспорт в JSON -->
                            <Button Grid.Column="2" 
                                    Content="JSON"
                                    Command="{Binding ExportSelectedVehicleCommand}"
                                    CommandParameter="json"
                                    Background="#074CBA" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" Height="36" CornerRadius="8"
                                    HorizontalAlignment="Stretch" Margin="4, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- НАСТРОЙКИ: ИНТЕРАКТИВНЫЙ ВЫБОР ТЕМЫ И ЯЗЫКА -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="18"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding Strings.AppSettings}" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" />

                        <!-- Тема оформления -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Strings.ThemeTitle}" Foreground="{Binding TextPrimaryColor}" FontSize="14" FontWeight="Medium" />
                            </StackPanel>

                            <!-- Кнопки выбора темы: Тёмная / Светлая -->
                            <Border Grid.Column="1" Background="{Binding CardBorderColor}" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="{Binding Strings.DarkTheme}" 
                                            Command="{Binding SetDarkThemeCommand}"
                                            Background="{Binding DarkThemeBtnBg}" 
                                            Foreground="{Binding DarkThemeBtnFg}" 
                                            FontWeight="SemiBold" FontSize="12" Height="30" Padding="12, 0" CornerRadius="6" />
                                    <Button Content="{Binding Strings.LightTheme}" 
                                            Command="{Binding SetLightThemeCommand}"
                                            Background="{Binding LightThemeBtnBg}" 
                                            Foreground="{Binding LightThemeBtnFg}" 
                                            FontWeight="SemiBold" FontSize="12" Height="30" Padding="12, 0" CornerRadius="6" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{Binding CardBorderColor}" />

                        <!-- Язык приложения -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Strings.LanguageTitle}" Foreground="{Binding TextPrimaryColor}" FontSize="14" FontWeight="Medium" />
                            </StackPanel>

                            <!-- Кнопки выбора языка: Русский / English -->
                            <Border Grid.Column="1" Background="{Binding CardBorderColor}" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="Русский" 
                                            Command="{Binding SetRussianLanguageCommand}"
                                            Background="{Binding RuLangBtnBg}" 
                                            Foreground="{Binding RuLangBtnFg}" 
                                            FontWeight="SemiBold" FontSize="12" Height="30" Padding="12, 0" CornerRadius="6" />
                                    <Button Content="English" 
                                            Command="{Binding SetEnglishLanguageCommand}"
                                            Background="{Binding EnLangBtnBg}" 
                                            Foreground="{Binding EnLangBtnFg}" 
                                            FontWeight="SemiBold" FontSize="12" Height="30" Padding="12, 0" CornerRadius="6" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- БАННЕР СИНХРОНИЗАЦИИ (Задел под будущий вход) -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="16"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" 
                                      Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z" 
                                      Width="22" Height="22" Foreground="#074CBA" Margin="0, 0, 10, 0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Strings.CloudSyncTitle}" FontSize="15" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Strings.CloudSyncDesc}" 
                                   Foreground="{Binding TextSecondaryColor}" FontSize="12" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== НИЖНЯЯ ПАНЕЛЬ (TELEGRAM FLOATING PILL BAR) ==================== -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{Binding BottomBarBgColor}"
                BorderBrush="{Binding BottomBarBorderColor}"
                BorderThickness="1"
                CornerRadius="29"
                Height="58"
                Padding="6, 4"
                Margin="0, 0, 0, 14"
                BoxShadow="0 8 32 #50000000">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Вкладка 1: Гараж -->
                <Button Command="{Binding SelectGarageTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="23"
                        Padding="0"
                        VerticalAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="23" />
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="23" />
                        </Style>
                    </Button.Styles>
                    <Border Background="{Binding GarageTabPillColor}"
                            CornerRadius="23"
                            Padding="22, 6">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <PathIcon Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4.66l.12-.34h13.77l.11.34V17z M7.5 15a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm9 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"
                                      Width="18" Height="18"
                                      Foreground="{Binding GarageTabColor}" />
                            <TextBlock Text="{Binding Strings.TabGarage}" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="{Binding GarageTabColor}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Вкладка 2: Аккаунт -->
                <Button Command="{Binding SelectAccountTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="23"
                        Padding="0"
                        VerticalAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="23" />
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="23" />
                        </Style>
                    </Button.Styles>
                    <Border Background="{Binding AccountTabPillColor}"
                            CornerRadius="23"
                            Padding="22, 6">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Width="18" Height="18"
                                      Foreground="{Binding AccountTabColor}" />
                            <TextBlock Text="{Binding Strings.TabAccount}" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="{Binding AccountTabColor}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>
            </StackPanel>
        </Border>

        <!-- СЛОЙ 1: Затемнение фона при открытии любой модальной формы -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B300080A"
                IsVisible="{Binding IsAnyFormOpen}">
            <!-- Клик по фону закрывает открытую форму -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding CloseAllFormsCommand}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Button.Styles>
            </Button>
        </Border>

        <!-- СЛОЙ 2: Формы ввода поверх затемнения (прокручиваются пальцем над клавиатурой) -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                      IsVisible="{Binding IsAnyInputFormOpen}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
            <Panel HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="440" Margin="16, 20, 16, 420">
                <!-- ФОРМА ДОБАВЛЕНИЯ / РЕДАКТИРОВАНИЯ АВТО -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="18"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1"
                        BoxShadow="0 8 32 #80000000"
                        IsVisible="{Binding IsAddingVehicle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding VehicleFormTitle}" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" />
                        
                        <TextBlock Text="{Binding VehicleErrorMessage}" Foreground="#E03E3E" FontWeight="SemiBold" FontSize="13" />

                        <!-- Марка и Модель (обе с подсказками и поддержкой русского/английского) -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Strings.Brand}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewBrand}" 
                                                 ItemsSource="{Binding BrandSuggestions}" 
                                                 FilterMode="None"
                                                 MinimumPrefixLength="0"
                                                 MaxDropDownHeight="140"
                                                 PlaceholderText="Toyota, Lada, Kia..." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="{Binding Strings.Model}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewModel}" 
                                                 ItemsSource="{Binding ModelSuggestions}" 
                                                 FilterMode="None"
                                                 MinimumPrefixLength="0"
                                                 MaxDropDownHeight="140"
                                                 PlaceholderText="Vesta, Rio, Camry..." />
                            </StackPanel>
                        </Grid>

                        <!-- Поколение и Год -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Strings.Generation}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewGeneration}" 
                                                 ItemsSource="{Binding GenerationSuggestions}" 
                                                 FilterMode="None"
                                                 MinimumPrefixLength="0"
                                                 MaxDropDownHeight="140"
                                                 PlaceholderText="{Binding Strings.GenerationPlaceholder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="{Binding Strings.Year}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <NumericUpDown Value="{Binding NewYear}" Minimum="1950" Maximum="2035" FormatString="N0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Двигатель (объем с подсказками) и Мощность (л.с.) -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Strings.Engine}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewEngineVolume}" 
                                                 ItemsSource="{Binding EngineSuggestions}" 
                                                 FilterMode="None"
                                                 MinimumPrefixLength="0"
                                                 MaxDropDownHeight="140"
                                                 PlaceholderText="{Binding Strings.EnginePlaceholder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="{Binding Strings.Horsepower}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewHorsepower}" 
                                                 ItemsSource="{Binding HorsepowerSuggestions}" 
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 MaxDropDownHeight="140"
                                                 PlaceholderText="105, 125, 150..." />
                            </StackPanel>
                        </Grid>

                        <!-- Цвет и Начальный пробег -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Strings.Color}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewColor}" 
                                                 ItemsSource="{Binding ColorSuggestions}" 
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 MaxDropDownHeight="140"
                                                 PlaceholderText="{Binding Strings.ColorPlaceholder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="{Binding Strings.MileageKm}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <NumericUpDown Value="{Binding NewVehicleMileage}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" PlaceholderText="0" />
                            </StackPanel>
                        </Grid>

                        <!-- Кнопки формы авто: Сохранить/Добавить и Отмена -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 6, 0, 0">
                            <Button Grid.Column="0" Content="{Binding VehicleFormSubmitButtonText}"
                                    Command="{Binding AddVehicleCommand}"
                                    Background="#074CBA" Foreground="White"
                                    FontWeight="Bold" Height="40" CornerRadius="8"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" Margin="0,0,5,0" />

                            <Button Grid.Column="1" Content="{Binding Strings.Cancel}"
                                    Command="{Binding CloseAllFormsCommand}"
                                    Background="{Binding CardBorderColor}" Foreground="{Binding TextSecondaryColor}"
                                    FontWeight="Medium" Height="40" CornerRadius="8"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" Margin="5,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ФОРМА ДОБАВЛЕНИЯ / РЕДАКТИРОВАНИЯ ЗАПИСИ О ЗАМЕНЕ -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="18"
                        BorderBrush="{Binding CardBorderColor}"
                        BorderThickness="1"
                        BoxShadow="0 8 32 #80000000"
                        IsVisible="{Binding IsAddingRecord}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding RecordFormTitle}" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" />

                        <TextBlock Text="{Binding RecordErrorMessage}" Foreground="#E03E3E" FontWeight="SemiBold" FontSize="13" />

                        <!-- Название детали -->
                                                <!-- Список деталей и их цены -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Strings.PartTitle}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />

                            <ItemsControl ItemsSource="{Binding NewPartItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:PartItem">
                                        <Grid ColumnDefinitions="*, Auto" Margin="0, 0, 0, 8">
                                            <!-- Прямоугольная рамка для одной детали -->
                                            <Border Grid.Column="0"
                                                    Background="{Binding #RootView.((vm:MainViewModel)DataContext).InputBgColor}"
                                                    BorderBrush="{Binding #RootView.((vm:MainViewModel)DataContext).CardBorderColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10">
                                                <StackPanel Spacing="8">
                                                    <AutoCompleteBox Text="{Binding Title}"
                                                                     ItemsSource="{Binding #RootView.((vm:MainViewModel)DataContext).PartTitleSuggestions}"
                                                                     FilterMode="Contains"
                                                                     MinimumPrefixLength="0"
                                                                     MaxDropDownHeight="150"
                                                                     PlaceholderText="{Binding #RootView.((vm:MainViewModel)DataContext).Strings.PartTitlePlaceholder}" />
                                                    <NumericUpDown Value="{Binding Cost}"
                                                                   Minimum="0"
                                                                   FormatString="N0"
                                                                   HorizontalAlignment="Stretch"
                                                                   PlaceholderText="{Binding #RootView.((vm:MainViewModel)DataContext).Strings.PartPricePlaceholder}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Круглый красный минус СНАРУЖИ справа (серый и неактивный, если деталь одна) -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding #RootView.((vm:MainViewModel)DataContext).RequestDeletePartItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding #RootView.((vm:MainViewModel)DataContext).CanDeletePartItem}"
                                                    Background="{Binding #RootView.((vm:MainViewModel)DataContext).DeletePartItemButtonBg}"
                                                    Foreground="{Binding #RootView.((vm:MainViewModel)DataContext).DeletePartItemButtonFg}"
                                                    Width="28" Height="28"
                                                    CornerRadius="14"
                                                    Padding="0"
                                                    Margin="8, 0, 0, 0"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#FF4D4D" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="CornerRadius" Value="14" />
                                                    </Style>
                                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#B82B2B" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="CornerRadius" Value="14" />
                                                    </Style>
                                                    <Style Selector="Button:disabled /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="{Binding #RootView.((vm:MainViewModel)DataContext).DeletePartItemButtonBg}" />
                                                        <Setter Property="Foreground" Value="{Binding #RootView.((vm:MainViewModel)DataContext).DeletePartItemButtonFg}" />
                                                        <Setter Property="CornerRadius" Value="14" />
                                                    </Style>
                                                </Button.Styles>
                                                <TextBlock Text="−" FontSize="18" FontWeight="Bold" Margin="0, -2, 0, 0" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Прямоугольная плашка с плюсиком снизу -->
                            <Button Command="{Binding AddPartItemCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="40"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    BorderBrush="#074CBA"
                                    BorderThickness="1.5">
                                <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="#074CBA" Margin="0, -2, 0, 0" />
                            </Button>
                        </StackPanel>

                        <!-- Дата замены -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Strings.Date}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                            <DatePicker SelectedDate="{Binding NewDate}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Пробег и Где меняли в две колонки -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 2, 0, 0">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0, 0, 5, 0">
                                <TextBlock Text="{Binding Strings.MileageKm}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <NumericUpDown Value="{Binding NewMileage}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5, 0, 0, 0">
                                <TextBlock Text="{Binding Strings.WhereReplaced}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                                <TextBox Text="{Binding NewServiceName}" PlaceholderText="{Binding Strings.ServiceLocationPlaceholder}" />
                            </StackPanel>
                        </Grid>

                        <!-- Цены: деталь и работа -->
                                                <!-- Цена работы -->
                        <StackPanel Spacing="4" Margin="0, 2, 0, 0">
                            <TextBlock Text="{Binding Strings.LaborPrice}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                            <NumericUpDown Value="{Binding NewLaborCost}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" PlaceholderText="0" />
                        </StackPanel>

                        <!-- Заметка -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Strings.Notes}" Foreground="{Binding TextSecondaryColor}" FontSize="12" />
                            <TextBox Text="{Binding NewNotes}" PlaceholderText="{Binding Strings.NotesPlaceholder}" />
                        </StackPanel>

                        <!-- Кнопки формы записи: Сохранить и Отмена -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 6, 0, 0">
                            <Button Grid.Column="0" Content="{Binding RecordFormSubmitButtonText}"
                                    Command="{Binding SaveRecordCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#074CBA"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Height="40"
                                    CornerRadius="8"
                                    Margin="0, 0, 5, 0" />

                            <Button Grid.Column="1" Content="{Binding Strings.Cancel}"
                                    Command="{Binding CloseAllFormsCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="{Binding CardBorderColor}"
                                    Foreground="{Binding TextSecondaryColor}"
                                    FontWeight="Medium"
                                    FontSize="14"
                                    Height="40"
                                    CornerRadius="8"
                                    Margin="5, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Panel>
        </ScrollViewer>

        <!-- СЛОЙ 3: Диалоги подтверждения удаления (всегда строго по центру экрана) -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsAnyDeleteConfirmOpen}">
            <Button Background="#66000000"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding CancelActiveDeleteCommand}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#66000000" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#66000000" />
                    </Style>
                </Button.Styles>
            </Button>

            <Panel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="20">
                <!-- ДИАЛОГ ПОДТВЕРЖДЕНИЯ УДАЛЕНИЯ АВТОМОБИЛЯ -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="22"
                        BorderBrush="#E03E3E"
                        BorderThickness="1"
                        BoxShadow="0 10 36 #A0000000"
                        IsVisible="{Binding IsConfirmingDeleteVehicle}">
                    <StackPanel Spacing="16">
                        <!-- Заголовок с предупреждением -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Strings.DeleteConfirmTitle}" 
                                       FontSize="19" 
                                       FontWeight="Bold" 
                                       Foreground="{Binding TextPrimaryColor}" />
                            <TextBlock Text="{Binding DeleteConfirmMessage}"
                                       Foreground="{Binding TextSecondaryColor}" 
                                       FontSize="13" 
                                       TextWrapping="Wrap" 
                                       LineHeight="18" />
                        </StackPanel>

                        <!-- Кнопки: Да, удалить и Отмена -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0" 
                                    Content="{Binding Strings.YesDelete}"
                                    Command="{Binding ConfirmDeleteVehicleCommand}"
                                    Background="#E03E3E" 
                                    Foreground="White"
                                    FontWeight="Bold" 
                                    Height="40" 
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" 
                                    Margin="0, 0, 5, 0" />

                            <Button Grid.Column="1" 
                                    Content="{Binding Strings.Cancel}"
                                    Command="{Binding CancelDeleteVehicleCommand}"
                                    Background="{Binding CardBorderColor}" 
                                    Foreground="{Binding TextSecondaryColor}"
                                    FontWeight="Medium" 
                                    Height="40" 
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" 
                                    Margin="5, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ДИАЛОГ ПОДТВЕРЖДЕНИЯ УДАЛЕНИЯ ЗАПИСИ ОБСЛУЖИВАНИЯ -->
                <Border Background="{Binding CardColor}" 
                        CornerRadius="16" 
                        Padding="22"
                        BorderBrush="#E03E3E"
                        BorderThickness="1"
                        BoxShadow="0 10 36 #A0000000"
                        IsVisible="{Binding IsConfirmingDeleteRecord}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Strings.DeleteRecordConfirmTitle}" 
                                       FontSize="19" 
                                       FontWeight="Bold" 
                                       Foreground="{Binding TextPrimaryColor}" />
                            <TextBlock Text="{Binding DeleteRecordConfirmMessage}"
                                       Foreground="{Binding TextSecondaryColor}" 
                                       FontSize="13" 
                                       TextWrapping="Wrap" 
                                       LineHeight="18" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0" 
                                    Content="{Binding Strings.YesDelete}"
                                    Command="{Binding ConfirmDeleteRecordCommand}"
                                    Background="#E03E3E" 
                                    Foreground="White"
                                    FontWeight="Bold" 
                                    Height="40" 
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" 
                                    Margin="0, 0, 5, 0" />

                            <Button Grid.Column="1" 
                                    Content="{Binding Strings.Cancel}"
                                    Command="{Binding CancelDeleteRecordCommand}"
                                    Background="{Binding CardBorderColor}" 
                                    Foreground="{Binding TextSecondaryColor}"
                                    FontWeight="Medium" 
                                    Height="40" 
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" 
                                    Margin="5, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ДИАЛОГ ПОДТВЕРЖДЕНИЯ УДАЛЕНИЯ ОДНОЙ ДЕТАЛИ ИЗ ФОРМЫ -->
                <Border Background="{Binding CardColor}"
                        CornerRadius="16"
                        Padding="22"
                        BorderBrush="#E03E3E"
                        BorderThickness="2"
                        BoxShadow="0 10 36 #C0000000"
                        IsVisible="{Binding IsConfirmingDeletePartItem}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Strings.DeletePartItemTitle}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{Binding TextPrimaryColor}" />
                            <TextBlock Text="{Binding DeletePartItemConfirmMessage}"
                                       Foreground="{Binding TextSecondaryColor}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0"
                                    Content="{Binding Strings.YesDelete}"
                                    Command="{Binding ConfirmDeletePartItemCommand}"
                                    Background="#E03E3E"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Height="40"
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Margin="0, 0, 5, 0" />

                            <Button Grid.Column="1"
                                    Content="{Binding Strings.Cancel}"
                                    Command="{Binding CancelDeletePartItemCommand}"
                                    Background="{Binding CardBorderColor}"
                                    Foreground="{Binding TextSecondaryColor}"
                                    FontWeight="Medium"
                                    Height="40"
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Margin="5, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
