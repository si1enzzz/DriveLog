<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCareApp.ViewModels"
        xmlns:m="using:AutoCareApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="470" d:DesignHeight="880"
        Width="480" Height="900"
        x:Class="AutoCareApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Журнал обслуживания авто"
        Background="#001114">

    <!-- Глобальные стили контролов -->
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#002127" />
            <Setter Property="BorderBrush" Value="#174A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="#002127" />
            <Setter Property="BorderBrush" Value="#174A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="38" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#002127" />
            <Setter Property="BorderBrush" Value="#174A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ShowButtonSpinner" Value="False" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#002127" />
            <Setter Property="BorderBrush" Value="#174A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#002127" />
            <Setter Property="BorderBrush" Value="#174A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="DatePicker /template/ Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="DatePicker /template/ TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="DatePicker /template/ Rectangle">
            <Setter Property="Fill" Value="#174A54" />
            <Setter Property="Width" Value="1" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto">
        <!-- СЛОЙ 0: Содержимое вкладок (Row 0) -->

        <!-- ВКЛАДКА 1: Гараж -->
        <ScrollViewer Grid.Row="0" Margin="16" IsVisible="{Binding IsGarageTab}">
            <StackPanel Spacing="14">

                <!-- ВЕРХНЯЯ ПАНЕЛЬ: Плюсик слева, селектор по центру, удаление справа -->
                <Border Background="#07343D" 
                        CornerRadius="12" 
                        Padding="10, 8"
                        BorderBrush="#144C57"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Кнопка «+» добавить авто (компактный стильный квадратик слева) -->
                        <Button Grid.Column="0" 
                                Content="+"
                                Command="{Binding ToggleAddVehicleCommand}"
                                ToolTip.Tip="Добавить новый автомобиль"
                                Background="#0CA61E"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="20"
                                Width="38" Height="38"
                                Padding="0"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />

                        <!-- Селектор машин (по центру) -->
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Vehicles}" 
                                  SelectedItem="{Binding SelectedVehicle}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Гараж пуст"
                                  Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Vehicle">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Medium" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Кнопка «Удалить» авто (открывает окно подтверждения) -->
                        <Button Grid.Column="2" 
                                Content="Удалить"
                                Command="{Binding RequestDeleteVehicleCommand}"
                                IsEnabled="{Binding CanDeleteVehicle}"
                                Background="#9C1111"
                                Foreground="White"
                                FontWeight="Medium"
                                FontSize="12"
                                Height="38"
                                Padding="12, 0"
                                CornerRadius="8"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
                    </Grid>
                </Border>

                <!-- КОНТЕНТ ВЫБРАННОГО АВТО (когда в гараже есть машины) -->
                <StackPanel Spacing="14" IsVisible="{Binding HasVehicles}">
                    <!-- ШАПКА: Карточка выбранного авто -->
                    <Border Background="#07343D" 
                            CornerRadius="14" 
                            Padding="18"
                            BorderBrush="#144C57"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- ЧИСТОЕ НАЗВАНИЕ АВТО (без дублирования года и объема) -->
                            <TextBlock Text="{Binding SelectedVehicle.Title}" FontSize="24" FontWeight="Bold" Foreground="White" />
                            
                            <!-- ВСЕ ХАРАКТЕРИСТИКИ ВМЕСТЕ (поколение, двигатель, год, цвет) -->
                            <TextBlock Text="{Binding SelectedVehicle.SubDetails}" Foreground="#7CA3AA" FontSize="13" />

                            <!-- Пробег и расходы (светлый читаемый красный) -->
                            <Grid ColumnDefinitions="*, Auto" Margin="0, 6, 0, 0">
                                <StackPanel>
                                    <TextBlock Text="Текущий пробег" Foreground="#7CA3AA" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedVehicle.CurrentMileage, StringFormat='{}{0:N0} км'}" 
                                               FontSize="22" FontWeight="Black" Foreground="#0CA61E" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Всего потрачено" Foreground="#7CA3AA" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding SelectedVehicle.TotalSpent, StringFormat='{}{0:N0} ₽'}" 
                                               FontSize="22" FontWeight="Black" Foreground="#E03E3E" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка «Добавить запись о замене» -->
                    <Button Content="Добавить запись о замене"
                            Command="{Binding ToggleAddFormCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#07343D"
                            BorderBrush="#1E5662"
                            BorderThickness="1"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Height="44"
                            CornerRadius="10" />

                    <!-- Заголовок истории обслуживания -->
                    <TextBlock Text="История обслуживания" FontSize="17" FontWeight="Bold" Foreground="White" Margin="4, 4, 0, 0" />

                    <!-- Список записей выбранной машины -->
                    <ItemsControl ItemsSource="{Binding SelectedVehicle.Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:ServiceRecord">
                                <!-- Карточка одной замены -->
                                <Border Background="#07343D" 
                                        CornerRadius="12" 
                                        Margin="0, 0, 0, 10" 
                                        Padding="16"
                                        BorderBrush="#144C57"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <!-- Название детали и общая стоимость -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="{Binding PartTitle}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalCost, StringFormat='{}{0:N0} ₽'}" 
                                                       FontSize="16" FontWeight="Bold" Foreground="#0CA61E" Margin="8,0,0,0" />
                                        </Grid>

                                        <!-- Информация: Пробег, Умная дата (без года для текущего года!), Сервис -->
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Mileage, StringFormat='{}{0:N0} км'}" Foreground="#7CA3AA" FontSize="13" />
                                            <TextBlock Text="  ·  " Foreground="#3A6A73" FontSize="13" />
                                            <TextBlock Text="{Binding DisplayDate}" Foreground="#7CA3AA" FontSize="13" />
                                            <TextBlock Text="  ·  " Foreground="#3A6A73" FontSize="13" />
                                            <TextBlock Text="{Binding ServiceName}" Foreground="#7CA3AA" FontSize="13" />
                                        </WrapPanel>

                                        <!-- Цены: деталь + работа -->
                                        <TextBlock Foreground="#4D7780" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Деталь: {0:N0} ₽   Работа: {1:N0} ₽">
                                                    <Binding Path="PartCost" />
                                                    <Binding Path="LaborCost" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- Заметка (если есть) -->
                                        <TextBlock Text="{Binding Notes}" 
                                                   Foreground="#85ABB3" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ПУСТОЙ ГАРАЖ (когда машин еще нет) -->
                <Border Background="#07343D" 
                        CornerRadius="16" 
                        Padding="28, 36" 
                        BorderBrush="#144C57" 
                        BorderThickness="1" 
                        IsVisible="{Binding !HasVehicles}" 
                        Margin="0, 20, 0, 0">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <TextBlock Text="Ваш гараж пуст" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Добавьте ваш первый автомобиль, чтобы начать вести журнал замен, контролировать пробег и расходы." 
                                   Foreground="#7CA3AA" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   MaxWidth="320" />
                        <Button Content="Добавить автомобиль" 
                                Command="{Binding ToggleAddVehicleCommand}" 
                                Background="#0CA61E" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="14" 
                                Height="42" 
                                Padding="24, 0" 
                                CornerRadius="8" 
                                HorizontalAlignment="Center" 
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" 
                                Margin="0, 8, 0, 0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ВКЛАДКА 2: Аккаунт и настройки -->
        <ScrollViewer Grid.Row="0" Margin="16" IsVisible="{Binding IsAccountTab}">
            <StackPanel Spacing="14">

                <!-- ШАПКА ПРОФИЛЯ ВОДИТЕЛЯ -->
                <Border Background="#07343D" 
                        CornerRadius="14" 
                        Padding="18"
                        BorderBrush="#144C57"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto, *">
                        <!-- Аватарка водителя -->
                        <Border Grid.Column="0" 
                                Width="56" Height="56" 
                                CornerRadius="28" 
                                Background="#0A4652" 
                                BorderBrush="#0CA61E" 
                                BorderThickness="2"
                                Margin="0, 0, 14, 0">
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Width="26" Height="26"
                                      Foreground="#0CA61E"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Имя и бейдж -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding DriverName}" 
                                           FontSize="20" FontWeight="Bold" Foreground="White" />
                                <Border Grid.Column="1" Background="#0A4652" CornerRadius="6" Padding="8, 2">
                                    <TextBlock Text="Гость" Foreground="#7CA3AA" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DriverExperience, StringFormat='Стаж вождения: {0}'}" 
                                       Foreground="#7CA3AA" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- КАРТОЧКА СВОДНОЙ СТАТИСТИКИ -->
                <Border Background="#07343D" 
                        CornerRadius="14" 
                        Padding="18"
                        BorderBrush="#144C57"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Сводная статистика гаража" FontSize="16" FontWeight="Bold" Foreground="White" />

                        <Grid ColumnDefinitions="*, *, *">
                            <!-- Всего авто -->
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Автомобилей" Foreground="#7CA3AA" FontSize="11" />
                                <TextBlock Text="{Binding Vehicles.Count}" FontSize="20" FontWeight="Black" Foreground="White" />
                            </StackPanel>

                            <!-- Всего замен -->
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Всего замен" Foreground="#7CA3AA" FontSize="11" />
                                <TextBlock Text="{Binding TotalRecordsCount}" FontSize="20" FontWeight="Black" Foreground="White" />
                            </StackPanel>

                            <!-- Общие затраты -->
                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock Text="Всего затрат" Foreground="#7CA3AA" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding TotalGarageSpent, StringFormat='{}{0:N0} ₽'}" 
                                           FontSize="17" FontWeight="Black" Foreground="#0CA61E" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ЭКСПОРТ ДАННЫХ И ОТЧЁТОВ -->
                <Border Background="#07343D" 
                        CornerRadius="14" 
                        Padding="18"
                        BorderBrush="#144C57"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Экспорт истории обслуживания" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Выгрузите отчёт по выбранному авто, чтобы распечатать, переслать покупателю или сохранить резервную копию." 
                                   Foreground="#7CA3AA" FontSize="12" TextWrapping="Wrap" LineHeight="16" />

                        <!-- Статус сохранения -->
                        <TextBlock Text="{Binding ExportStatusMessage}" 
                                   Foreground="#0CA61E" FontSize="12" FontWeight="SemiBold" 
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*, *, *" Margin="0, 4, 0, 0">
                            <!-- Экспорт в Markdown -->
                            <Button Grid.Column="0" 
                                    Content="Markdown"
                                    Command="{Binding ExportSelectedVehicleCommand}"
                                    CommandParameter="md"
                                    Background="#004D5A" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" Height="36" CornerRadius="8"
                                    HorizontalAlignment="Stretch" Margin="0, 0, 4, 0" />

                            <!-- Экспорт в TXT -->
                            <Button Grid.Column="1" 
                                    Content="Текст (TXT)"
                                    Command="{Binding ExportSelectedVehicleCommand}"
                                    CommandParameter="txt"
                                    Background="#004D5A" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" Height="36" CornerRadius="8"
                                    HorizontalAlignment="Stretch" Margin="4, 0, 4, 0" />

                            <!-- Экспорт в JSON -->
                            <Button Grid.Column="2" 
                                    Content="JSON"
                                    Command="{Binding ExportSelectedVehicleCommand}"
                                    CommandParameter="json"
                                    Background="#004D5A" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" Height="36" CornerRadius="8"
                                    HorizontalAlignment="Stretch" Margin="4, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- НАСТРОЙКИ (ТЕМА И ЯЗЫК) -->
                <Border Background="#07343D" 
                        CornerRadius="14" 
                        Padding="18"
                        BorderBrush="#144C57"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Настройки приложения" FontSize="16" FontWeight="Bold" Foreground="White" />

                        <!-- Тема оформления -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Тема оформления" Foreground="White" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Тёмная тема (активна)" Foreground="#7CA3AA" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A4652" CornerRadius="6" Padding="10, 4" VerticalAlignment="Center">
                                <TextBlock Text="Тёмная" Foreground="#0CA61E" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="#144C57" />

                        <!-- Язык приложения -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Язык приложения" Foreground="White" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Русский / English / 中文" Foreground="#7CA3AA" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A4652" CornerRadius="6" Padding="10, 4" VerticalAlignment="Center">
                                <TextBlock Text="Русский" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- БАННЕР СИНХРОНИЗАЦИИ (Задел под Этап 3: Вход по почте) -->
                <Border Background="#002127" 
                        CornerRadius="14" 
                        Padding="16"
                        BorderBrush="#174A54"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto, *">
                            <PathIcon Grid.Column="0" 
                                      Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z" 
                                      Width="22" Height="22" Foreground="#0CA61E" Margin="0, 0, 10, 0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Облачная синхронизация" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Вход и регистрация по почте появятся на следующем этапе. Ваши данные надёжно сохранены в локальной базе данных SQLite на этом устройстве." 
                                   Foreground="#7CA3AA" FontSize="12" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- НИЖНЯЯ ПАНЕЛЬ НАВИГАЦИИ (Telegram-style таббар) -->
        <Border Grid.Row="1"
                Background="#031E23"
                BorderBrush="#0C3D46"
                BorderThickness="0, 1, 0, 0"
                Padding="0, 6, 0, 8">
            <Grid ColumnDefinitions="*, *">
                <!-- Вкладка 1: Гараж -->
                <Button Grid.Column="0"
                        Command="{Binding SelectGarageTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <PathIcon Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4.66l.12-.34h13.77l.11.34V17z"
                                  Width="20" Height="20"
                                  Foreground="{Binding GarageTabColor}" />
                        <TextBlock Text="Гараж" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{Binding GarageTabColor}" />
                    </StackPanel>
                </Button>

                <!-- Вкладка 2: Аккаунт -->
                <Button Grid.Column="1"
                        Command="{Binding SelectAccountTabCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Width="20" Height="20"
                                  Foreground="{Binding AccountTabColor}" />
                        <TextBlock Text="Аккаунт" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{Binding AccountTabColor}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- СЛОЙ 1: Затемнение фона при открытии любой модальной формы -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B300080A"
                IsVisible="{Binding IsAnyFormOpen}">
            <!-- Клик по фону закрывает открытую форму -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding CloseAllFormsCommand}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Button.Styles>
            </Button>
        </Border>

        <!-- СЛОЙ 2: Модальные окна поверх затемнения -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                      IsVisible="{Binding IsAnyFormOpen}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="440"
                      MaxHeight="780"
                      Margin="16">
            <Panel>
                <!-- ФОРМА ДОБАВЛЕНИЯ НОВОГО АВТО -->
                <Border Background="#07343D" 
                        CornerRadius="14" 
                        Padding="18"
                        BorderBrush="#1A5E6B"
                        BorderThickness="1"
                        BoxShadow="0 8 32 #80000000"
                        IsVisible="{Binding IsAddingVehicle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Новый автомобиль" FontSize="18" FontWeight="Bold" Foreground="White" />
                        
                        <TextBlock Text="{Binding VehicleErrorMessage}" Foreground="#E03E3E" FontWeight="SemiBold" FontSize="13" />

                        <!-- Марка и Модель (обе с подсказками Avito) -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="Марка *" Foreground="#7CA3AA" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewBrand}" 
                                                 ItemsSource="{Binding BrandSuggestions}" 
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 PlaceholderText="Toyota, Lada, Kia..." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="Модель *" Foreground="#7CA3AA" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewModel}" 
                                                 ItemsSource="{Binding ModelSuggestions}" 
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 PlaceholderText="Vesta, Rio, Camry..." />
                            </StackPanel>
                        </Grid>

                        <!-- Поколение и Год -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="Поколение" Foreground="#7CA3AA" FontSize="12" />
                                <AutoCompleteBox Text="{Binding NewGeneration}" 
                                                 ItemsSource="{Binding GenerationSuggestions}" 
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="0"
                                                 PlaceholderText="I, II Рестайлинг..." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="Год выпуска" Foreground="#7CA3AA" FontSize="12" />
                                <NumericUpDown Value="{Binding NewYear}" Minimum="1950" Maximum="2035" FormatString="N0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Объем двигателя и Цвет -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="Объем двигателя" Foreground="#7CA3AA" FontSize="12" />
                                <TextBox Text="{Binding NewEngineVolume}" PlaceholderText="1.6, 2.0, 1.5T..." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="Цвет" Foreground="#7CA3AA" FontSize="12" />
                                <TextBox Text="{Binding NewColor}" PlaceholderText="Белый, Черный..." />
                            </StackPanel>
                        </Grid>

                        <!-- Начальный пробег -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Текущий пробег (км)" Foreground="#7CA3AA" FontSize="12" />
                            <NumericUpDown Value="{Binding NewVehicleMileage}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Кнопки формы авто: Добавить и Отмена -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 6, 0, 0">
                            <Button Grid.Column="0" Content="Добавить"
                                    Command="{Binding AddVehicleCommand}"
                                    Background="#0CA61E" Foreground="White"
                                    FontWeight="Bold" Height="40" CornerRadius="8"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" Margin="0,0,5,0" />

                            <Button Grid.Column="1" Content="Отмена"
                                    Command="{Binding CloseAllFormsCommand}"
                                    Background="#002127" Foreground="#7CA3AA"
                                    FontWeight="Medium" Height="40" CornerRadius="8"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" Margin="5,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ФОРМА ДОБАВЛЕНИЯ ЗАПИСИ О ЗАМЕНЕ -->
                <Border Background="#07343D" 
                        CornerRadius="14" 
                        Padding="18"
                        BorderBrush="#1E5662"
                        BorderThickness="1"
                        BoxShadow="0 8 32 #80000000"
                        IsVisible="{Binding IsAddingRecord}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Новая запись о замене" FontSize="18" FontWeight="Bold" Foreground="White" />

                        <TextBlock Text="{Binding RecordErrorMessage}" Foreground="#E03E3E" FontWeight="SemiBold" FontSize="13" />

                        <!-- Название детали -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Что меняли *" Foreground="#7CA3AA" FontSize="12" />
                            <TextBox Text="{Binding NewPartTitle}" PlaceholderText="Например: Свечи зажигания NGK" />
                        </StackPanel>

                        <!-- Дата замены (на всю ширину карточки, чтобы день, месяц и год не сжимались) -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Дата замены" Foreground="#7CA3AA" FontSize="12" />
                            <DatePicker SelectedDate="{Binding NewDate}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Пробег и Где меняли в две колонки -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 2, 0, 0">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0, 0, 5, 0">
                                <TextBlock Text="Пробег (км)" Foreground="#7CA3AA" FontSize="12" />
                                <NumericUpDown Value="{Binding NewMileage}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5, 0, 0, 0">
                                <TextBlock Text="Где меняли" Foreground="#7CA3AA" FontSize="12" />
                                <TextBox Text="{Binding NewServiceName}" PlaceholderText="Сам в гараже / СТО" />
                            </StackPanel>
                        </Grid>

                        <!-- Цены: деталь и работа (без стрелочек) -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 2, 0, 0">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0, 0, 5, 0">
                                <TextBlock Text="Цена детали (₽)" Foreground="#7CA3AA" FontSize="12" />
                                <NumericUpDown Value="{Binding NewPartCost}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5, 0, 0, 0">
                                <TextBlock Text="Цена работы (₽)" Foreground="#7CA3AA" FontSize="12" />
                                <NumericUpDown Value="{Binding NewLaborCost}" Minimum="0" FormatString="N0" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Заметка -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Заметка / Артикул" Foreground="#7CA3AA" FontSize="12" />
                            <TextBox Text="{Binding NewNotes}" PlaceholderText="Артикул детали, бренд, вязкость..." />
                        </StackPanel>

                        <!-- Кнопки формы записи: Сохранить и Отмена -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 6, 0, 0">
                            <Button Grid.Column="0" Content="Сохранить запись"
                                    Command="{Binding SaveRecordCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#0CA61E"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Height="40"
                                    CornerRadius="8"
                                    Margin="0, 0, 5, 0" />

                            <Button Grid.Column="1" Content="Отмена"
                                    Command="{Binding CloseAllFormsCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#002127"
                                    Foreground="#7CA3AA"
                                    FontWeight="Medium"
                                    FontSize="14"
                                    Height="40"
                                    CornerRadius="8"
                                    Margin="5, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ДИАЛОГ ПОДТВЕРЖДЕНИЯ УДАЛЕНИЯ АВТОМОБИЛЯ -->
                <Border Background="#07343D" 
                        CornerRadius="16" 
                        Padding="22"
                        BorderBrush="#E03E3E"
                        BorderThickness="1"
                        BoxShadow="0 10 36 #A0000000"
                        IsVisible="{Binding IsConfirmingDeleteVehicle}"
                        MaxWidth="380">
                    <StackPanel Spacing="16">
                        <!-- Заголовок с предупреждением -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Удалить автомобиль?" 
                                       FontSize="19" 
                                       FontWeight="Bold" 
                                       Foreground="White" />
                            <TextBlock Foreground="#B8D0D5" 
                                       FontSize="13" 
                                       TextWrapping="Wrap" 
                                       LineHeight="18">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Вы уверены, что хотите удалить {0}? Все данные и история обслуживания ({1} записей) будут удалены безвозвратно.">
                                        <Binding Path="SelectedVehicle.Title" />
                                        <Binding Path="SelectedVehicle.Records.Count" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Кнопки: Да, удалить и Отмена -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0" 
                                    Content="Да, удалить"
                                    Command="{Binding ConfirmDeleteVehicleCommand}"
                                    Background="#E03E3E" 
                                    Foreground="White"
                                    FontWeight="Bold" 
                                    Height="40" 
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" 
                                    Margin="0, 0, 5, 0" />

                            <Button Grid.Column="1" 
                                    Content="Отмена"
                                    Command="{Binding CancelDeleteVehicleCommand}"
                                    Background="#002127" 
                                    Foreground="#7CA3AA"
                                    FontWeight="Medium" 
                                    Height="40" 
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" 
                                    Margin="5, 0, 0, 0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Panel>
        </ScrollViewer>
    </Grid>
</Window>
